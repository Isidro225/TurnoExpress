// TurnoExpress — multi-tenant booking SaaS
// Path-based tenancy: cada Tenant se identifica por `slug` en la URL (turnoexpress.com/<slug>)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// Tenants (negocios que contratan la plataforma)
// ──────────────────────────────────────────────────────────────────────────────

model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  businessType  String?
  description     String?
  logoUrl         String?
  primaryColor    String?  @default("#0ea5e9")
  titleFont       String   @default("system")
  timezone        String   @default("America/Argentina/Buenos_Aires")
  currency      String   @default("ARS")

  // Mercado Pago credenciales por negocio (cada negocio cobra a su propia cuenta)
  mpAccessToken String?
  mpPublicKey   String?

  // % de seña por defecto sobre el precio del servicio (override por servicio si hace falta)
  depositPct    Int      @default(30)
  // Monto mínimo de seña en centavos. 0 = sin mínimo. Se aplica sobre el porcentaje:
  // la seña final será max(porcentaje, depositMinCents, piso técnico de MP).
  depositMinCents Int    @default(0)

  // Franja horaria visible en el calendario admin (0..24, end > start).
  calendarStartHour Int @default(7)
  calendarEndHour   Int @default(23)

  // Billing de TurnoExpress (abono mensual que paga el negocio a la plataforma)
  billingPlan          String  @default("pro")
  billingStatus        String  @default("pending")
  trialStartedAt       DateTime?
  trialEndsAt          DateTime?
  mpSubscriptionId     String? @unique
  mpSubscriptionStatus String?

  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  staff         Staff[]
  services      Service[]
  priorServices PriorService[]
  designs       Design[]
  appointments  Appointment[]
  payments      Payment[]
  customers     Customer[]

  @@index([slug])
  @@index([businessType])
  @@index([trialEndsAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Auth (Auth.js / NextAuth con adapter Prisma)
// ──────────────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(ADMIN)
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────────────────────────────────────
// Staff y servicios
// ──────────────────────────────────────────────────────────────────────────────

model Staff {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  bio       String?
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     StaffService[]
  schedules    StaffSchedule[]
  timeOff      TimeOff[]
  appointments Appointment[]

  @@index([tenantId])
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  durationMin Int
  priceCents  Int
  depositPct  Int?
  // Solo se usa en negocios "nails": "hands" o "feet". Habilita combinar manos+pies en una reserva.
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff                  StaffService[]
  appointments           Appointment[] @relation("AppointmentService")
  appointmentsSecondary  Appointment[] @relation("AppointmentSecondaryService")

  @@index([tenantId])
}

// Solo se usa en negocios tipo "nails": catálogo de diseños que el cliente puede sumar
// al servicio. Cada diseño tiene su propio tiempo y precio.
model Design {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  durationMin Int
  priceCents  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@index([tenantId])
}

// Solo se usa en negocios tipo "nails": lista de servicios que un cliente puede declarar
// "ya tener hechos" al reservar (puede no coincidir con los servicios que el negocio ofrece).
// `removalMin` es el tiempo que lleva retirar ese servicio cuando aplica modo retiro.
model PriorService {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  removalMin  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

// Horario semanal recurrente: el staff trabaja de tal hora a tal hora cada `weekday`.
model StaffSchedule {
  id       String @id @default(cuid())
  staffId  String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int

  @@index([staffId, weekday])
}

// Bloqueos puntuales (vacaciones, ausencias, feriados particulares).
model TimeOff {
  id       String   @id @default(cuid())
  staffId  String
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  @@index([staffId, startsAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Turnos y pagos
// ──────────────────────────────────────────────────────────────────────────────

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cliente persistente (agrupa por teléfono normalizado dentro del tenant). Opcional
  // porque turnos sin teléfono no se pueden agrupar; los snapshots customerName/Email/Phone
  // siguen siendo la fuente de verdad para visualización.
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceId     String
  service       Service           @relation("AppointmentService", fields: [serviceId], references: [id])
  // Servicio secundario opcional: en negocios "nails" se permite combinar manos + pies en un turno.
  secondaryServiceId          String?
  secondaryService            Service? @relation("AppointmentSecondaryService", fields: [secondaryServiceId], references: [id], onDelete: SetNull)
  secondaryServiceName        String?
  secondaryServicePriceCents  Int?
  secondaryServiceDurationMin Int?
  staffId       String
  staff         Staff             @relation(fields: [staffId], references: [id])
  startsAt      DateTime
  endsAt        DateTime
  status        AppointmentStatus @default(PENDING_PAYMENT)
  customerName  String
  customerEmail String
  customerPhone String?
  notes         String?
  priceCents    Int
  depositCents  Int
  // Snapshots específicos del flujo de uñas. Quedan nulos para otros tipos de negocio.
  priorServiceName String?
  priorAge         String? // "D15_21" | "D21_25" | "MONTH_PLUS"
  procedureMode    String? // "fresh" | "service" | "retiro"
  designId         String?
  design           Design?  @relation(fields: [designId], references: [id], onDelete: SetNull)
  designName       String?
  designPriceCents Int?
  extraMinutes     Int     @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  payments Payment[]

  @@index([tenantId, startsAt])
  @@index([staffId, startsAt])
  @@index([status])
  @@index([customerId])
}

// Cliente persistente del negocio. Agrupa los turnos por teléfono normalizado
// (sólo dígitos) dentro del tenant. Los datos snapshot del turno (customerName/Email/Phone)
// se conservan para no alterar registros históricos si la ficha del cliente cambia.
model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone     String   // Normalizado: sólo dígitos. Ver lib/customers.ts.
  name      String
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId String
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  provider      String        @default("mercadopago")
  preferenceId  String?
  paymentId     String?
  amountCents   Int
  status        PaymentStatus @default(PENDING)
  rawPayload    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([appointmentId])
  @@index([preferenceId])
  @@index([paymentId])
}
